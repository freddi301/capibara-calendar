{
  "name": "capibara-calendar-ui",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "publish:webxdc": "bash scripts/publish-webxdc.sh",
    "webxdc:simulate": "webxdc-dev run http://localhost:5173",
    "webxdc:pack": "vite build --mode webxdc --outDir dist-webxdc --emptyOutDir && rm -f calendario.xdc && cd dist-webxdc && zip -rX ../calendario.xdc .",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "knip": "knip",
    "extract": "lingui extract",
    "seed:scenarios": "node scripts/seed-scenarios.mjs",
    "seed:variants": "node scripts/seed-event-variants.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:agent": "vitest run --reporter=minimal",
    "test:e2e:agent": "playwright test --reporter=./e2e/agent-reporter.ts",
    "test:layout:agent": "playwright test -c playwright.layout.config.ts --reporter=./e2e/agent-reporter.ts",
    "check:agent": "node scripts/check-agent.mjs",
    "check": "npm run typecheck && npm run lint && npm run fmt:check && npm run knip && npm test",
    "prepare": "cd .. && husky capibara-calendar-ui/.husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@formkit/auto-animate": "^0.10.2",
    "@hookform/resolvers": "^7.0.5",
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/query-async-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "es-toolkit": "^1.53.2",
    "ical.js": "^2.2.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "temporal-polyfill": "^1.0.8",
    "tsdav": "^2.5.0",
    "tw-animate-css": "^1.4.0",
    "y-webxdc": "^1.4.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "^6.12.0",
    "@lingui/vite-plugin": "^6.12.0",
    "@playwright/cli": "^0.1.24",
    "@playwright/test": "^1.65.0",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webxdc/webxdc-dev": "^0.21.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-lingui": "^0.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "knip": "^6.45.0",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*": "prettier --write --ignore-unknown"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
